set terminal postscript eps enhanced color "TimesNewRoman,24"
set colorsequence classic
set output "FyIVP-varyfxi.eps"
set border 15 lw 1
set tmargin 0
set bmargin 0
set rmargin 0
set lmargin 0
set size 1.03,1.98
set style line 1 lt 1 lc rgb "#FF0000" lw 2 pt 7 ps 1.5
set style line 2 lt 1 lc rgb "#00AA00" lw 2 pt 7 ps 1.5
set style line 3 lt 1 lc rgb "#0000FF" lw 2 pt 7 ps 1.5
set style line 4 lt 1 lc rgb "#AA00AA" lw 2 pt 7 ps 1.5
set style line 5 lt 1 lc rgb "#009977" lw 2 pt 7 ps 1.5
set style line 6 lt 1 lc rgb "#000000" lw 2
set style line 7 lt 0 lc rgb "#FF0000" lw 3
set style line 8 lt 0 lc rgb "#000000" lw 3
set multiplot
#
set size 0.8,0.8
set origin 0.2,0.2
set xrange [-4.356:-4.337]
set yrange [0:2.4]
set xtics 0.005
set ylabel "pairing gap {/Symbol= D}_p  [MeV]" offset 0
set xlabel "pairing parameter f_{/Symbol= x}" offset 0
unset key
#set arrow from 0,graph 0 to 0,graph 1 nohead lt 0 lw 1
set label "state-wise pair.breakdown" at graph 0.02,0.6
set label "global pair.breakdown" at graph 0.6,0.3
set arrow from graph 0.6,0.26 to graph 0.565,0.02 lt 1 lc 0 lw 2
set arrow from graph 0.47,0.62 to graph 0.5,0.72 lt 1 lc 0 lw 2
#set label 1 "BCS, width=0" at graph 0.55,0.92
p  "FyIVP-varyfxi.gnu" i 2 u 1:4 not  w lp ls 1
#
unset label
unset arrow
set size 0.8,0.8
set origin 0.2,1.0
#set xrange [-47:89]
set yrange [165:300]
#set ytics 1
set ylabel "quality measure {/Symbol= c}^2" offset 0
set xlabel "" offset 0
set form x ""
unset key
#set arrow from 0,graph 0 to 0,graph 1 nohead lt 0 lw 1
#set label "^{120}Sn, SV-bas, BCS" at graph 0.03,0.09
set title "Fy(IVP), no stabilization, cutoff=25 MeV, (incomplete) refit"
p  "FyIVP-varyfxi.gnu" i 0 u 1:2 not  w lp ls 1
#
!eps2pdf -f FyIVP-varyfxi.eps
!rm -f FyIVP-varyfxi.eps
!evince FyIVP-varyfxi.pdf
q

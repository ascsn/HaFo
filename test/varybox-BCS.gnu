set terminal postscript eps enhanced color "TimesNewRoman,34"
set colorsequence classic
set output "varybox-BCS.eps"
set border 15 lw 1
set tmargin 0
set bmargin 0
set rmargin 0
set lmargin 0
set size 1.07,1.95
set origin 0,-0.0
set style line 1 lt 1 lc rgb "#FF0000" lw 3 pt 7 ps 1.5
set style line 2 lt 1 lc rgb "#00AA00" lw 3 pt 7 ps 1.5
set style line 3 lt 1 lc rgb "#0000FF" lw 3 pt 7 ps 1.5
set style line 4 lt 1 lc rgb "#AA00AA" lw 3 pt 7 ps 1.5
set style line 5 lt 1 lc 5 lw 3 pt 7 ps 1.5
#set style line 5 lt 1 lc rgb "#009977" lw 3 pt 7 ps 1.5
set style line 6 lt 1 lc rgb "#000000" lw 3 
set style line 7 lt 0 lc rgb "#FF0000" lw 3
set style line 8 lt 0 lc rgb "#000000" lw 3
set multiplot
#
set size 0.8,0.8
set origin 0.24,0.2
set xrange [15:29]
#set yrange [0:4.45]
#set ytics 1
set ylabel "neutron pairing energy  [MeV]" offset 0
set xlabel "box radius [fm]" offset 0
set key bottom left
#set arrow from 0,graph 0 to 0,graph 1 nohead lt 0 lw 1
#set label "^{120}Sn, SV-bas, BCS" at graph 0.03,0.09
#set label 1 "BCS, width=0" at graph 0.55,0.92
p  "varybox-BCS.gnu" i 0 u (($1-1)*0.3):4 t "width=0.0" w l ls 1,\
  "varybox-BCS.gnu" i 3 u (($1-1)*0.3):4 t "width=1.0" w l ls 2,\
  "varybox-BCS.gnu" i 2 u (($1-1)*0.3):4 t "width=2.0" w l ls 3,\
  "varybox-BCS.gnu" i 4 u (($1-1)*0.3):4 t "width=2.5" w l ls 4,\
  "varybox-BCS.gnu" i 1 u (($1-1)*0.3):4 t "width=3.0" w l ls 5
#
set size 0.8,0.8
set origin 0.24,1.0
set xrange [15:29]
set form x ""
#set yrange [0:4.45]
#set ytics 1
set ylabel "binding energy  [MeV]" offset 0.8
set xlabel "" offset 0
set key bottom left
#set arrow from 0,graph 0 to 0,graph 1 nohead lt 0 lw 1
set title "^{120}Sn, SV-bas, BCS" offset 0,-0.3
p  "varybox-BCS.gnu" i 0 u (($1-1)*0.3):3 t "width=0.0" w l ls 1,\
  "varybox-BCS.gnu" i 3 u (($1-1)*0.3):3 t "width=1.0" w l ls 2,\
  "varybox-BCS.gnu" i 2 u (($1-1)*0.3):3 t "width=2.0" w l ls 3,\
  "varybox-BCS.gnu" i 4 u (($1-1)*0.3):3 t "width=2.5" w l ls 4,\
  "varybox-BCS.gnu" i 1 u (($1-1)*0.3):3 t "width=3.0" w l ls 5
#
!eps2pdf -f varybox-BCS.eps
!rm -f varybox-BCS.eps
!evince varybox-BCS.pdf
q

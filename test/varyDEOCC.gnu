set terminal postscript eps enhanced color "TimesNewRoman,30"
set colorsequence classic
set output "varyDEOCC.eps"
set border 15 lw 1
set tmargin 0
set bmargin 0
set rmargin 0
set lmargin 0
set size 2.02,1.98
set style line 1 lt 1 lc rgb "#FF0000" lw 2 pt 7 ps 0.8
set style line 2 lt 1 lc rgb "#00AA00" lw 2 pt 7 ps 0.8
set style line 3 lt 1 lc rgb "#0000FF" lw 2 pt 7 ps 0.8
set style line 4 lt 1 lc rgb "#AA00AA" lw 2 pt 7 ps 0.8
set style line 5 lt 1 lc rgb "#009977" lw 2 pt 7 ps 0.8
set style line 6 lt 1 lc rgb "#000000" lw 2
set style line 7 lt 0 lc rgb "#FF0000" lw 3
set style line 8 lt 0 lc rgb "#000000" lw 3
set multiplot
#
set size 0.8,0.8
set origin 0.2,0.2
set xrange [0:18]
set yrange [-27:-20.1]
set ylabel "neutron pairing energy [MeV]" offset 0
set xlabel "DEOCC" offset 0
set key at graph 0.95,0.86 box
p  "varyDEOCC.gnu" i 0 u 2:6 t "cut 15, width 0" w lp ls 1,\
  "varyDEOCC.gnu" i 1 u 2:6 t "cut 15, width 1" w lp ls 2,\
  "varyDEOCC.gnu" i 2 u 2:6 t "cut 30, width 0" w lp ls 3,\
  "varyDEOCC.gnu" i 3 u 2:6 t "cut 30, width 1" w lp ls 4
#
set size 0.8,0.8
set origin 1.17,0.2
set xrange [0:18]
set yrange [-19.6:-10.1]
set ylabel "" offset 0
set xlabel "DEOCC" offset 0
set key at graph 0.95,0.55 box
p  "varyDEOCC.gnu" i 4 u 2:6 t "cut 15, width 0" w lp ls 1,\
  "varyDEOCC.gnu" i 5 u 2:6 t "cut 15, width 1" w lp ls 2,\
  "varyDEOCC.gnu" i 6 u 2:6 t "cut 30, width 0" w lp ls 3,\
  "varyDEOCC.gnu" i 7 u 2:6 t "cut 30, width 1" w lp ls 4
#
set size 0.8,0.8
set origin 0.2,1.0
set form x ""
set xlabel ""
set yrange [1.81:2.36]
set key at graph 0.95,0.5  box
set ylabel "neutron pairing gap {/Symbol= D}  [MeV]" offset 0
set title "^{120}Sn, FyDr re-tuned, HFB" 
p  "varyDEOCC.gnu" i 0 u 2:8 t "cut 15, width 0" w lp ls 1,\
  "varyDEOCC.gnu" i 1 u 2:8 t "cut 15, width 1" w lp ls 2,\
  "varyDEOCC.gnu" i 2 u 2:8 t "cut 30, width 0" w lp ls 3,\
  "varyDEOCC.gnu" i 3 u 2:8 t "cut 30, width 1" w lp ls 4
#
set size 0.8,0.8
set origin 1.17,1.0
set form x ""
set xlabel ""
set yrange [1.11:1.75]
set ylabel "" offset 0
set key at graph 0.95,0.5  box
set title "^{120}Sn, FyDr re-tuned, BCS" 
p  "varyDEOCC.gnu" i 4 u 2:8 t "cut 15, width 0" w lp ls 1,\
  "varyDEOCC.gnu" i 5 u 2:8 t "cut 15, width 1" w lp ls 2,\
  "varyDEOCC.gnu" i 6 u 2:8 t "cut 30, width 0" w lp ls 3,\
  "varyDEOCC.gnu" i 7 u 2:8 t "cut 30, width 1" w lp ls 4
#
!eps2pdf -f varyDEOCC.eps
!rm -f varyDEOCC.eps
!evince varyDEOCC.pdf
q

set terminal postscript eps enhanced color "TimesNewRoman,30"
set colorsequence classic
set output "variances-formf-52Ca.eps"
set border 15 lw 1
set tmargin 0
set bmargin 0
set rmargin 0
set lmargin 0
set size 2.08,2.18
set style line 1 lt 1 lc rgb "#FF0000" lw 2 pt 7 ps 0.8
set style line 2 lt 1 lc rgb "#00AA00" lw 2 pt 7 ps 0.8
set style line 3 lt 1 lc rgb "#0000FF" lw 2 pt 7 ps 0.8
set style line 4 lt 1 lc rgb "#AA00AA" lw 2 pt 7 ps 0.8
set style line 5 lt 1 lc rgb "#009977" lw 2 pt 7 ps 0.8
set style line 6 lt 1 lc rgb "#000000" lw 2
set style line 7 lt 0 lc rgb "#FF0000" lw 3
set style line 8 lt 0 lc rgb "#000000" lw 3
set style fill solid 0.2
set multiplot
#
set size 0.8,0.8
set origin 0.2,1.35
set xrange [0:5.2]
set yrange [1e-4:50]
set form y "10^{%T}"
set ylabel "proton formfactor" offset 1.2
set xlabel "q  [fm^{-1}]" offset 0
set key top right 
set log y
set label "^{52}Ca, Fy({/Symbol= D}r,HFB)" at graph 0.5,0.9
p  "variances-formf-52Ca.gnu" i 0 u 1:(abs($4-$5)):(abs($4+$5)) not w filledcurves,\
  "variances-formf-52Ca.gnu" i 0 u 1:(abs($4)) not w l ls 1
#
unset label
set size 0.8,0.8
set origin 1.25,1.35
set xrange [0:5.2]
#set yrange [0:0.115]
set ylabel "neutron formfactor" offset 1.2
set xlabel "q  [fm^{-1}]" offset 0
set key top right 
#set label "^{120}Sn, SV-bas, BCS" at graph 0.03,0.09
p  "variances-formf-52Ca.gnu" i 0 u 1:(abs($6-$7)):(abs($6+$7)) not w filledcurves,\
  "variances-formf-52Ca.gnu" i 0 u 1:(abs($6)) not w l ls 1
#
set auto
unset log y
set size 0.8,0.8
set origin 0.18,0.2
set xrange [0:5.2]
set yrange [0:5.2]
set form y "%g"
set ylabel "q  [fm^{-1}]" offset 1.2
set xlabel "q  [fm^{-1}]" offset 0
#set cblabel "CoD"
set key top right 
set title "CoD for proton formfactor"
#set label "^{52}Ca, Fy({/Symbol= D}r,HFB)" at graph 0.5,0.9
p  "variances-formf-52Ca.gnu" i 1 u 1:2:($4**2) not w p pt 5 ps 1.5 palette
#
set auto
set size 0.8,0.8
set origin 1.18,0.2
set xrange [0:5.2]
set yrange [0:5.2]
set ylabel "q  [fm^{-1}]" offset 1.2
set xlabel "q  [fm^{-1}]" offset 0
set cblabel "CoD"
set key top right 
#set label "^{52}Ca, Fy({/Symbol= D}r,HFB)" at graph 0.5,0.9
set title "CoD for neutron formfactor"
p  "variances-formf-52Ca.gnu" i 1 u 1:2:($5**2) not w p pt 5 ps 1.5 palette
#
!eps2pdf -f variances-formf-52Ca.eps
!rm -f variances-formf-52Ca.eps
!evince variances-formf-52Ca.pdf
q

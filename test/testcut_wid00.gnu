set terminal postscript eps enhanced color "TimesNewRoman,34"
set colorsequence classic
set output "testcut_wid00.eps"
set border 15 lw 1
set tmargin 0
set bmargin 0
set rmargin 0
set lmargin 0
set size 2.18,1.98
set style line 1 lt 1 lc rgb "#FF0000" lw 2 pt 7 ps 1.5
set style line 2 lt 1 lc rgb "#00AA00" lw 2 pt 5 ps 1.5
set style line 3 lt 1 lc rgb "#0000FF" lw 2 pt 4 ps 1.5
set style line 4 lt 1 lc rgb "#AA00AA" lw 2 pt 6 ps 1.5
set style line 5 lt 1 lc rgb "#00CCAA" lw 2 pt 9 ps 1.5
set style line 6 lt 1 lc rgb "#000000" lw 2
set style line 7 lt 0 lc rgb "#FF0000" lw 3
set style line 8 lt 0 lc rgb "#000000" lw 3
set multiplot
#set palette defined (1e-8 "black", 1e-7 "blue", 1e-6 "green", 1e-5 "yellow", 1e-4 "orange", 1e-3 "red")
set palette defined (-8 "black", -7 "blue", -6 "green", -5 "yellow", -4 "orange", -3 "red")
#
set size 0.8,0.8
set origin 0.2,0.2
set yrange [0:19.5]
set xrange [-50:199]
#set ytics 0.001
set xlabel "s.p. energy  [MeV]" offset 0,0.2
set ylabel "s.p. radius [fm]" offset 0
set cbrange [-8:-3]
set form cb "10^{%T}"
set label 1 "{/Symbol= e}_{cut}=100 MeV" at graph 0.03,0.9
unset log cb
unset key 
unset colorbox
p "testcut_wid00.gnu" i 0 u 3:6:(log10($4*$9)) w p pt 7 ps 1 palette
#
set size 0.8,0.8
set origin 1.0,0.2
set form y ""
set xlabel "s.p. energy  [MeV]"
set ylabel "" offset 0
set label 1 "{/Symbol= e}_{cut}=100 MeV" at graph 0.03,0.9
p "testcut_wid00.gnu" i 1 u 3:6:(log10($4)) w p pt 7 ps 1 palette
#
unset title
set size 0.8,0.8
set origin 0.2,1.0
set form y 
set form x ""
set xlabel ""
set ylabel "s.p. radius [fm]" offset 0
set title "v^2 cutoff" offset 0,-0.2
set label 1 "{/Symbol= e}_{cut}=25 MeV" at graph 0.03,0.9
p "testcut_wid00.gnu" i 2 u 3:6:(log10($4*$9)) w p pt 7 ps 1 palette
#
set size 0.8,0.8
set origin 1.0,1.0
set form y ""
set xlabel ""
set ylabel "" offset 0
set cbrange [-8:-3]
unset log cb
set title "{/Symbol= D} cutoff"
#set colorbox 
set colorbox user origin 1.89,0.2 size 0.05,1.6
set cblabel "occupation weight w_n"
set cbtics ("10^{-8}" -8, "10^{-7}" -7, "10^{-6}" -6, "10^{-5}" -5, "10^{-4}" -4, "10^{-3}" -3)
set label 1 "{/Symbol= e}_{cut}=25 MeV" at graph 0.63,0.9
set label "{/=40 folding radius 0}" at graph -0.2,1.15
p "testcut_wid00.gnu" i 3 u 3:6:(log10($4)) w p pt 7 ps 1 palette
#
!eps2pdf -f testcut_wid00.eps
!rm -f testcut_wid00.eps
!evince testcut_wid00.pdf
q

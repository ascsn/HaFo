set terminal postscript eps enhanced color "TimesNewRoman,30"
set colorsequence classic
set output "FyIVP-convergence.eps"
set border 15 lw 1
set tmargin 0
set bmargin 0
set rmargin 0
set lmargin 0
set size 2.13,1.98
set style line 1 lt 1 lc rgb "#FF0000" lw 2 pt 7 ps 0.8
set style line 11 lt 0 lc rgb "#FF0000" lw 2 pt 7 ps 0.8
set style line 2 lt 1 lc rgb "#00AA00" lw 2 pt 7 ps 0.8
set style line 21 lt 0 lc rgb "#00AA00" lw 2 pt 7 ps 0.8
set style line 3 lt 1 lc rgb "#0000FF" lw 2 pt 7 ps 0.8
set style line 4 lt 1 lc rgb "#AA00AA" lw 2 pt 7 ps 0.8
set style line 5 lt 1 lc rgb "#009977" lw 2 pt 7 ps 0.8
set style line 6 lt 1 lc rgb "#000000" lw 2
set style line 7 lt 0 lc rgb "#FF0000" lw 3
set style line 8 lt 0 lc rgb "#000000" lw 3
set multiplot
#
set size 0.8,0.8
set origin 0.2,0.2
set xrange [0:49990]
set xtics 10000
set yrange [-0.22:-0.151]
set ylabel "E_{pair,prot}  [MeV]" offset 0.9
set xlabel "iterations" offset 0
set key bottom right box
p  "FyIVP-convergence.gnu" i 1 u (($0)*1000):1 t "odd step=0.1" w l ls 1,\
  "FyIVP-convergence.gnu" i 2 u (($0)*1000):1 t "odd step=0.3" w l ls 11,\
  "FyIVP-convergence.gnu" i 3 u (($0)*1000):1 t "SkyAx step=0.1" w l ls 2,\
  "FyIVP-convergence.gnu" i 4 u (($0)*1000):1 t "SkyAx step=0.3" w l ls 21,\
  "FyIVP-convergence.gnu" i 4 u ($0*1000):(-0.161) t "1D code" w l ls 3
#
set size 0.8,0.8
set origin 0.2,1.0
#set xrange [0:49999]
set xtics 10000
set form x ""
set yrange [-12.8:-8.4]
set ylabel "E_{pair,neut}  [MeV]" offset 0.9
set xlabel "" offset 0
set key bottom right box
p  "FyIVP-convergence.gnu" i 1 u (($0)*1000):2 t "odd step=0.1" w l ls 1,\
  "FyIVP-convergence.gnu" i 2 u (($0)*1000):2 t "odd step=0.3" w l ls 11,\
  "FyIVP-convergence.gnu" i 3 u (($0)*1000):2 t "SkyAx step=0.1" w l ls 2,\
  "FyIVP-convergence.gnu" i 4 u (($0)*1000):2 t "SkyAx step=0.3" w l ls 21,\
  "FyIVP-convergence.gnu" i 4 u ($0*1000):(-9.228) t "1D code" w l ls 3
#
set size 0.8,0.8
set origin 1.3,0.2
#set xrange [0:49999]
set xtics 10000
set form x
set yrange [4.5851:4.5939]
set ylabel "r_p  [fm]" offset 0.9
set xlabel "iterations" offset 0
set key top right box
p  "FyIVP-convergence.gnu" i 1 u (($0)*1000):3 t "odd step=0.1" w l ls 1,\
  "FyIVP-convergence.gnu" i 2 u (($0)*1000):3 t "odd step=0.3" w l ls 11,\
  "FyIVP-convergence.gnu" i 3 u (($0)*1000):3 t "SkyAx step=0.1" w l ls 2,\
  "FyIVP-convergence.gnu" i 4 u ($0*1000):3 t "SkyAx step=0.3" w l ls 21,\
  "FyIVP-convergence.gnu" i 4 u ($0*1000):(4.5864) t "1D code" w l ls 3
#
set size 0.8,0.8
set origin 1.3,1.0
#set xrange [0:49999]
set xtics 10000
set form x ""
set yrange [-1016.89:-1016]
set ylabel "E_B  [MeV]" offset 0.9
set xlabel "" offset 0
set key top right box
set title "{/=40 ^{120}Sn, Fy(IVP), convergence of HFB iterations}" offset -22,0.4
p  "FyIVP-convergence.gnu" i 1 u (($0)*1000):5 t "odd step=0.1" w l ls 1,\
  "FyIVP-convergence.gnu" i 2 u (($0)*1000):5 t "odd step=0.3" w l ls 11,\
  "FyIVP-convergence.gnu" i 3 u (($0)*1000):5 t "SkyAx step=0.1" w l ls 2,\
  "FyIVP-convergence.gnu" i 4 u (($0)*1000):5 t "SkyAx step=0.3" w l ls 21,\
  "FyIVP-convergence.gnu" i 4 u ($0*1000):(-1016.540) t "1D code" w l ls 3
#
!eps2pdf -f FyIVP-convergence.eps
!rm -f FyIVP-convergence.eps
!evince FyIVP-convergence.pdf
q

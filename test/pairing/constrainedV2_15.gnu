set terminal epslatex color font "Helvetica,10" standalone
set output "varyocc_widths_cut15.tex"

set colorsequence classic
set border 15 lw 1

set style line 1 lt 1 lc rgb "#FF0000" lw 5 pt 7 ps 1.5
set style line 2 lt 1 lc rgb "#00AA00" lw 5 pt 7 ps 1.5
set style line 3 lt 1 lc rgb "#0000FF" lw 5 pt 7 ps 1.5
set style line 4 lt 1 lc rgb "#AA00AA" lw 5 pt 7 ps 1.5
set style line 5 lt 1 lc rgb "#009977" lw 5 pt 7 ps 1.5
set style line 6 lt 1 lc rgb "#000000" lw 2
set style line 7 lt 0 lc rgb "#FF0000" lw 5
set style line 8 lt 0 lc rgb "#000000" lw 5
unset colorbox

set multiplot layout 3,2 margins 0.14,0.95,0.14,0.95 spacing 0,0

# ---- Plot 1 (Top-left) ----
set auto
unset label
unset arrow
set xrange [0:0.13]
set yrange [-0.02:0.079]
set ytics 0.02
set ylabel '$E_{B}$ [MeV]'
unset xtics
set arrow from 0,0 to 0.125,0 nohead lt 0 lw 1
set label 1 'HFB, $\tilde{R}_{\mathcal{F}}$ = 0 fm' at graph 0.02,0.88
plot "constrainedV2_15.gnu" i 0 u (sqrt($4)):($5+1017.41142) t "" w l ls 1

# ---- Plot 2 (Top-right) ----
unset ylabel
unset ytics
unset xtics
unset label
set arrow from 0,0 to 0.125,0 nohead lt 0 lw 1
set label 1 'HFB, $\tilde{R}_{\mathcal{F}}$ = 0.5 fm' at graph 0.02,0.88
plot "constrainedV2_15.gnu" i 1 u (sqrt($4)):($5+1018.05405) t "" w l ls 1

# ---- Plot 3 (Middle-left) ----
set ytics 0.02
set ylabel '$E_{B}$ [MeV]'
unset xtics
unset label
set arrow from 0,0 to 0.125,0 nohead lt 0 lw 1
set label 1 'HFB, $\tilde{R}_{\mathcal{F}}$ = 1.0 fm' at graph 0.02,0.88
plot "constrainedV2_15.gnu" i 2 u (sqrt($4)):($5+1018.84173) t "" w l ls 1

# ---- Plot 4 (Middle-right) ----
unset ylabel
unset ytics
unset xtics
unset label
set arrow from 0,0 to 0.125,0 nohead lt 0 lw 1
set label 1 'HFB, $\tilde{R}_{\mathcal{F}}$ = 1.5 fm' at graph 0.4,0.88
plot "constrainedV2_15.gnu" i 3 u (sqrt($4)):($5+1018.51386) t "" w l ls 3

# ---- Plot 5 (Bottom-left) ----
set ytics 0.02
set xtics 0.02
set ylabel '$E_{B}$ [MeV]'
set xlabel 'occupation amplitude $v_{n}$'
unset label
set label '{\large $^{120}$Sn}' at graph 0.24,0.32
set label '{\large SV-bas}' at graph 0.14,0.2
set label 1 'HFB, $\tilde{R}_{\mathcal{F}}$ = 2 fm' at graph 0.4,0.88
plot "constrainedV2_15.gnu" i 4 u (sqrt($4)):($5+1016.86462) t "" w l ls 5

# ---- Plot 6 (Bottom-right) ----
unset ylabel
set xtics 0.02
set xlabel 'occupation amplitude $v_{n}$'
unset ytics
unset label
set label 1 'HFB, $\tilde{R}_{\mathcal{F}}$ = 2.5 fm' at graph 0.4,0.88
plot "constrainedV2_15.gnu" i 5 u (sqrt($4)):($5+1015.60164) t "" w l ls 1

unset multiplot
q

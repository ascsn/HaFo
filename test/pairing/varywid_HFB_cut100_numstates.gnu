#set terminal postscript eps enhanced color "TimesNewRoman,30"
set terminal epslatex color colortext font "Helvetica,14" solid round standalone
set colorsequence classic
#set output "varywid_HFB_cut100_numstates.eps"
set output "varywid_HFB_cut100_numstates.tex"
set border 15 lw 1
set tmargin 0
set bmargin 0
set rmargin 0
set lmargin 0
set size 1.03,1.03
set style line 1 lt 1 lc rgb "#FF0000" lw 4 pt 7 ps 0.8
set style line 2 lt 1 lc rgb "#00AA00" lw 4 pt 7 ps 0.8
set style line 3 lt 1 lc rgb "#0000FF" lw 4 pt 7 ps 0.8
set style line 4 lt 1 lc rgb "#AA00AA" lw 4 pt 7 ps 0.8
set style line 5 lt 1 lc rgb "#009977" lw 4 pt 7 ps 0.8
set style line 6 lt 1 lc rgb "#000000" lw 2
set style line 7 lt 0 lc rgb "#FF0000" lw 3
set style line 8 lt 0 lc rgb "#000000" lw 3
#set palette defined (0 "black", 0.2 "blue", 0.4 "green", 0.8 "orange", 1.0 "red")
set multiplot
#
set size 0.8,0.8
set origin 0.2,0.2
#set xrange [-47:139]
set yrange [0:2700]
set ylabel "nr. of states" offset 0
set xlabel "s.p. energy  (MeV)" offset 0
set key at graph 1.0,0.33 spacing 1.08
set label "{\\large $^{120}$Sn}" at graph 0.84,0.77
set label "{\\large SV-bas}" at graph 0.88,0.63
p  "varywid_HFB_cut100_numstates.gnu" i 0 u 2:3 t "HFB $\\tilde{R}_\\mathcal{F}$=0" w l ls 1,\
  "varywid_HFB_cut100_numstates.gnu" i 1 u 2:3 t "HFB $\\tilde{R}_\\mathcal{F}$=1" w l ls 2,\
  "varywid_HFB_cut100_numstates.gnu" i 2 u 2:3 t "HFB $\\tilde{R}_\\mathcal{F}$=2" w l ls 3,\
  "varywid_HFB_cut100_numstates.gnu" i 3 u 2:3 t "BCS $\\tilde{R}_\\mathcal{F}$=0" w l ls 4
#
#!eps2pdf -f varywid_HFB_cut100_numstates.eps
#!rm -f varywid_HFB_cut100_numstates.eps
#!evince varywid_HFB_cut100_numstates.pdf
q

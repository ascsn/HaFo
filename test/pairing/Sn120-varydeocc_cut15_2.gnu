#set terminal po eps enhanced color "TimesNewRoman,33"
set terminal epslatex color colortext font 17 solid round standalone
set colorsequence classic
#set output "Sn120-varydeocc_cut15_2.eps"
set output "Sn120-varydeocc_cut15_2.tex"
set border 15 lw 1
set tmargin 0
set bmargin 0
set lmargin 0
set rmargin 0
set size 1.43,1.99
set multiplot
#
set origin 0.2,0.23
set size 0.6,0.8
set xlabel "$N_\\mathrm{states}^{1/3}$"
set ylabel "neutron pairing energy (MeV)" offset -0.5
set key at graph 0.99,0.98 spacing 1.16
set xrange [6.8:13.95]
#set yrange [-0.07:0.005]
set yrange [-1:19.9]
#set ytics 1
p "Sn120-varydeocc_cut15_2.gnu"  i 1  u ($3**0.33333):($9+26.830) t "$\\tilde{R}_\\mathcal{F}$=0, HFB" w l lw 4,\
 "Sn120-varydeocc_cut15_2.gnu"  i 0  u ($3**0.33333):($9+19.219) t "$\\tilde{R}_\\mathcal{F}$=0, BCS" w l lw 4 lc rgb '#00aa00',\
 "Sn120-varydeocc_cut15_2.gnu"  i 3  u ($3**0.33333):($9+19.973) t "$\\tilde{R}_\\mathcal{F}$=1 fm, HFB" w l lw 4,\
 "Sn120-varydeocc_cut15_2.gnu"  i 2  u ($3**0.33333):($9+18.124) t "$\\tilde{R}_\\mathcal{F}$=1 fm, BCS" w l lw 4
#
set origin 0.2,1.03
set size 0.6,0.8
set xlabel ""
set form x ""
set ylabel "charge radius ($10^{-3}$fm)" offset 0.3
#set key at graph 2.15,1.28 maxcolumns 4 maxrows 1
#set yrange [-0.015:0.07]
set yrange [-22:2]
#set ytics 1
set key at graph 0.99,0.42
set title "Fy($\\Delta r$), $^{120}$Sn, $\\varepsilon_\\mathrm{cut}$ = 15 MeV"
p "Sn120-varydeocc_cut15_2.gnu"  i 1  u ($3**0.33333):(($6-4.668917)*1e3) t "$\\tilde{R}_\\mathcal{F}$=0, HFB" w l lw 4,\
 "Sn120-varydeocc_cut15_2.gnu"  i 0  u ($3**0.33333):(($6-4.659498)*1e3) t "$\\tilde{R}_\\mathcal{F}$=0, BCS" w l lw 4 lc rgb '#00aa00',\
 "Sn120-varydeocc_cut15_2.gnu"  i 3  u ($3**0.33333):(($6-4.661443)*1e3) t "$\\tilde{R}_\\mathcal{F}$=1 fm, HFB" w l lw 4,\
 "Sn120-varydeocc_cut15_2.gnu"  i 2  u ($3**0.33333):(($6-4.652495)*1e3) t "$\\tilde{R}_\\mathcal{F}$=1 fm, BCS" w l lw 4
#
unset title
set origin 0.8,0.23
set size 0.6,0.8
set xlabel "$N_\\mathrm{states}^{1/3}$"
set form x 
set ylabel "" offset 1.5
set form y ""
set key at graph 0.99,0.98
#set xrange [1.5:10.5]
set yrange [-1:19.9]
#set ytics 1
p "Sn120-varydeocc_cut15_2.gnu"  i 5  u ($3**0.33333):($9+27.097) t "$\\tilde{R}_\\mathcal{F}$=0, HFB" w l lw 4,\
 "Sn120-varydeocc_cut15_2.gnu"  i 4  u ($3**0.33333):($9+38.004) t "$\\tilde{R}_\\mathcal{F}$=0, BCS" w l lc rgb '#00aa00' lw 4,\
 "Sn120-varydeocc_cut15_2.gnu"  i 7  u ($3**0.33333):($9+24.922) t "$\\tilde{R}_\\mathcal{F}$=1 fm, HFB" w l lw 4,\
 "Sn120-varydeocc_cut15_2.gnu"  i 6  u ($3**0.33333):($9+24.157) t "$\\tilde{R}_\\mathcal{F}$=1 fm, BCS" w l lw 4
#
set origin 0.8,1.03
set size 0.6,0.8
set xlabel ""
set form x ""
set ylabel "" offset 1.5
#unset key 
set key at graph 0.99,0.42 noinvert
#set xrange [1.5:10.5]
set yrange [-22:2]
#set ytics 1
set title "Fy($\\Delta r$), $^{120}$Sn, $\\varepsilon_\\mathrm{cut}$ = 45 MeV"
p "Sn120-varydeocc_cut15_2.gnu"  i 5  u ($3**0.33333):(($6-4.669307)*1e3) t "$\\tilde{R}_\\mathcal{F}$=0, HFB" w l lw 4,\
 "Sn120-varydeocc_cut15_2.gnu"  i 4  u ($3**0.33333):(($6-4.675436)*1e3) t "$\\tilde{R}_\\mathcal{F}$=0, BCS" w l lc rgb '#00aa00' lw 4,\
 "Sn120-varydeocc_cut15_2.gnu"  i 7  u ($3**0.33333):(($6-4.662187)*1e3) t "$\\tilde{R}_\\mathcal{F}$=1 fm, HFB" w l lw 4,\
 "Sn120-varydeocc_cut15_2.gnu"  i 6  u ($3**0.33333):(($6-4.661550)*1e3) t "$\\tilde{R}_\\mathcal{F}$=1 fm, BCS" w l lw 4

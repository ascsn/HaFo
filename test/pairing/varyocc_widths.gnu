set terminal postscript eps enhanced color "TimesNewRoman,34"
set colorsequence classic
set output "varyocc_widths.eps"
set border 15 lw 1
set tmargin 0
set bmargin 0
set rmargin 0
set lmargin 0
set size 3.03,2.88
set origin 0,-0.83
set style line 1 lt 1 lc rgb "#FF0000" lw 5 pt 7 ps 1.5
set style line 2 lt 1 lc rgb "#00AA00" lw 5 pt 7 ps 1.5
set style line 3 lt 1 lc rgb "#0000FF" lw 5 pt 7 ps 1.5
set style line 4 lt 1 lc rgb "#AA00AA" lw 5 pt 7 ps 1.5
set style line 5 lt 1 lc rgb "#009977" lw 5 pt 7 ps 1.5
set style line 6 lt 1 lc rgb "#000000" lw 2
set style line 7 lt 0 lc rgb "#FF0000" lw 5
set style line 8 lt 0 lc rgb "#000000" lw 5
set multiplot
#
set size 0.8,0.6
set origin 0.2,-0.6
set xrange [0:0.1] #0.005]
set yrange [-0.01:]
set ytics 0.02
set ylabel "E_B  [MeV]" offset 1.4
set xlabel "occupation amplitude v_{2p_{1/2},n}" offset 0
unset key
set arrow from 0,0 to 0.115,0 nohead lt 0 lw 1
#set label "^{120}Sn, SV-bas, BCS" at graph 0.03,0.09
set label 1 "BCS, {/Symbol G}_{fold} = 0 fm" at graph 0.55,0.92
p  "varyocc_widths.gnu" i 4 u (sqrt($4)):($5+1018.80481) t "width=0.0" w l ls 1

set terminal postscript eps enhanced color "TimesNewRoman,30"
set colorsequence classic
set output "variances-rho-52Ca.eps"
set border 15 lw 1
set tmargin 0
set bmargin 0
set rmargin 0
set lmargin 0
set size 2.08,2.18
set style line 1 lt 1 lc rgb "#FF0000" lw 2 pt 7 ps 0.8
set style line 2 lt 1 lc rgb "#00AA00" lw 2 pt 7 ps 0.8
set style line 3 lt 1 lc rgb "#0000FF" lw 2 pt 7 ps 0.8
set style line 4 lt 1 lc rgb "#AA00AA" lw 2 pt 7 ps 0.8
set style line 5 lt 1 lc rgb "#009977" lw 2 pt 7 ps 0.8
set style line 6 lt 1 lc rgb "#000000" lw 2
set style line 7 lt 0 lc rgb "#FF0000" lw 3
set style line 8 lt 0 lc rgb "#000000" lw 3
set style fill solid 0.2
set multiplot
#
set size 0.8,0.8
set origin 0.2,1.35
set xrange [0:13.9]
set yrange [0:0.115]
set ylabel "proton density [fm^{-3}]" offset 1.2
set xlabel "r  [fm]" offset 0
set key top right 
set label "^{52}Ca, Fy({/Symbol= D}r,HFB)" at graph 0.5,0.9
p  "variances-rho-52Ca.gnu" i 0 u 1:($4-$5):($4+$5) not w filledcurves,\
  "variances-rho-52Ca.gnu" i 0 u 1:4 not w l ls 1
#
unset label
set size 0.8,0.8
set origin 1.25,1.35
set xrange [0:13.9]
set yrange [0:0.115]
set ylabel "neutron density [fm^{-3}]" offset 1.2
set xlabel "r  [fm]" offset 0
set key top right 
#set label "^{120}Sn, SV-bas, BCS" at graph 0.03,0.09
p  "variances-rho-52Ca.gnu" i 0 u 1:($6-$7):($6+$7) not w filledcurves,\
  "variances-rho-52Ca.gnu" i 0 u 1:6 not w l ls 1
#
set auto
set size 0.8,0.8
set origin 0.18,0.2
set xrange [0:13.9]
set yrange [0:13.9]
set ylabel "r  [fm]" offset 1.2
set xlabel "r  [fm]" offset 0
#set cblabel "CoD"
set key top right 
set title "CoD for proton density"
#set label "^{52}Ca, Fy({/Symbol= D}r,HFB)" at graph 0.5,0.9
p  "variances-rho-52Ca.gnu" i 1 u 1:2:($4**2) not w p pt 5 ps 1.5 palette
#
set auto
set size 0.8,0.8
set origin 1.18,0.2
set xrange [0:13.9]
set yrange [0:13.9]
set ylabel "r  [fm]" offset 1.2
set xlabel "r  [fm]" offset 0
set cblabel "CoD"
set key top right 
#set label "^{52}Ca, Fy({/Symbol= D}r,HFB)" at graph 0.5,0.9
set title "CoD for neutron density"
p  "variances-rho-52Ca.gnu" i 1 u 1:2:($5**2) not w p pt 5 ps 1.5 palette
#
!eps2pdf -f variances-rho-52Ca.eps
!rm -f variances-rho-52Ca.eps
!evince variances-rho-52Ca.pdf
q

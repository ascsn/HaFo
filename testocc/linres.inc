C INCLUDE BLOCK: LINRES
C
C     FIELDS FOR THE LINEAR RESPONSE PART IN SUMRULE APPROXIMATION:
C      QLROUT = Q-OPERATOR STORED AS WAVE-FUNCTIONS
C      PLROUT = P-OPERATOR STORED AS WAVE-FUNCTIONS
C      QLRIMG = IMAGINARY PART OF Q-OPERATOR STORED AS WAVE-FUNCTIONS
C      PLRIMG = IMAGINARY PART OF P-OPERATOR STORED AS WAVE-FUNCTIONS
C      QBLROT = [H,P]-OPERATOR STORED AS WAVE FUNCTIONS
C      HLINRS = WORKSPACE FOR EVALUATING THE ACTION OF THE LINEAR
C               RESPONSE HAMILTONIAN ON A WAVE FUNCTION
C      WORK1  = GENERAL WORKSPACE
C      WORK2  = GENERAL WORKSPACE
C      WORK3  = GENERAL WORKSPACE
C      QRAD   = FIELD FOR THE LOCAL Q-OPERATOR
C      qradob = field for local observable in case of Bessel
C      QCUR   = Q-RESPONSE CURRENT
C      DQCUR  = DERIVATIVE OF Q-RESPONSE CURRENT
C      RQCUR  = ROTATION OF Q-RESPONSE CURRENT
C      PRHO   = P-RESPONSE DENSITY
C      DPRHO  = DERIVATIVE OF P-RESPONSE DENSITY
C      D2PRHO = SECOND DERIVATIVE OF P-RESPONSE DENSITY
C      PTAU   = P-RESPONSE KINETIC DENISITY
C      PSJ    = P-RESPONSE SPIN-ORBIT DENSITY
C      DPSJ   = DERIVATIVE OF P-RESPONSE SPIN-ORBIT DENSITY
C      SIGMA  = SPIN-CURRENT
C      RPOT   = POTENTIAL OF RESPONSE HAMILTONIAN
C      RPOTLS = SPIN-ORBIT POTENTIAL OF RESPONSE HAMILTONIAN
C      RBMASS = INVERSE MASS OF RESPONSE HAMILTONIAN
C
C      ALRPA  = LRPA AS REAL NUMBER
C      ENEXT  = ENERGY OF EXTERNAL SOURCE, IN CASE OF LINEAR RESPONSE
C      ENWID  = WIDTH OF SCANNING LINEAR RESPONSE
C      LRPA   = ANGULAR MOMENTUM OF THE ACTUAL RPA MODE
C      MLRPA  = DEGENERACY OF THE RPA MODE = 2*LRPA+1
C      ISORPA = ISOSPIN+1 OF THE RPA MODE
C      IFCMPL = SWITCH COMPLEX RESPONSE WAVE FUNCTION,
C               0  --> 'QLR' AND 'PLR' ARE REAL AND STORED ON '...OUT'
C               1  --> 'QLR' AND 'PLR' ARE COMPLEX, IMAGINARY PART
C                      ON '...IMG'
C      RESDMP = CUTOFF-MOMENTUM FOR THE RESIDUAL INTTERACTION
C      qobsrev= momentum for Bessel functions as observable
C      IFSEPI = SWITCH TO SEPARABLE Q*Q INTERACTION, STRENGTH IS
C               TRANSFERRED VIA 'RESFAC'
C
      parameter (KGOBS=KG1*KSCDIP+1)
      logical tspinorbit
C
      COMMON/QPLPSI/ QLROUT(KX11,KLRPA),PLROUT(KX11,KLRPA),
     &               SAVLR(KX11,KLRPA),
     &               QRESIN(KRESWF,KLRPA),PRESIN(KRESWF,KLRPA),
     &               HLINRS(KG1),WORK1(KG1),WORK2(KG1),WORK3(KG1),
     &               QRAD(KGR2),qradob(KGOBS),
     &               QCUR(KGR2,2),DQCUR(KGR2),RQCUR(KGR2,1),
     &               qcurmag(KGR2,2),                                 ! magnetic
     &               PRHO(KGR2),DPRHO(KGR2),D2PRHO(KGR2),
     &               PTAU(KGR2),DPTAU(KGR2),D2PTAU(KGR2),                !mod
     &               PSJ(KGR2,2),PSJS(KGR2),SIGMA(KGR2),                 !mod
     &               RKIN(KGR2,2),DRKIN(KGR2),
     &               RSPIN(KGR2),RSIGMA(KGR2,2),
     &               RPOT(KGR2),RPOTLS(KGR2,2),RBMASS(KGR2),
     &               DRBMAS(KGR2,2),
     &               ALRPA,RESDMP,qobserv,
     &               LRPA,MLRPA,ISORPA,IFSEPI,
     &               ifrsph,tspinorbit
C
c      switches for testing.
c
       logical tnob1,tnosurf,tsemicl
       parameter (tnob1=.false.)
       parameter (tnosurf=.false.)
       parameter (tsemicl=.false.)  ! semiclassical "tau"
c
C END INCLUDE BLOCK

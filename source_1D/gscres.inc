C INCLUDE BLOCK: GSCRES
C
C      BLOCK TO STORE AND TRANSFER RESUTS ON GROUND-STATE-CORRELATIONS.
C      THE VARIABLES AND ARRAYS IN COMMON /RESULT/ MEAN:
C       DELSIG  = DELTA-SIGMA^2 FOR R.M.S. RADIUS
C       RDMSCR  = CORRELATION ON DIFFRACTION RADII
C       SURFCR  = CORRELATION ON SURFACES
C       ENERGC  = CORRELATION ENERGY
C       WGTC    = CORRELATION ON WEIGHT.
C       IRUNC   = NUMBER OF CORRELATION RUN
C      FIELDS (2,2,2,2)  MEAN (ISO,IBOX,ISCAT,IRUNC) WHERE
C       ISO     = PROTON OR NEUTRON
C       IBOX    = PP OR HH
C       ISCAT   = DIRECT OR SCATTERING DIAGRAM
C       IRUNC   = 1. OR 2. RUN OF RESFAC
C      FIELD 'ENERGC(2,2)' MEANS (IBOX,IRUNC).
C      FIELD 'WGTC' MEANS 'WGTC(NR.OF SHELLS,IRUNC)
C
       COMMON /GSCRES/ DELSIG(2,2,2,2),RDMSCR(2,2,2,2),
     &                 SURFCR(2,2,2,2),ENERGC(2,2),
     &                 WGTC(KSL2,2),
     &                 IRUNC
C END INCLUDE BLOCK

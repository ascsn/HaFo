C INCLUDE BLOCK: REDMTS
C
      LOGICAL TTABLE
C
C     STORAGE FOR FREQUENTLY USED REDUCED MATRIX ELEMENTS.
C     THE FOLLOWING ELEMENTS ARE STORED:
C      REDMT   = CALL TO 'REDUME'
C      REDSG   = CALL TO 'REDSIG'
C      DERCR   = 'FACDER' FROM CALL TO 'REDCUR'
C      RADCR   = 'FACRAD' FROM CALL TO 'REDCUR'
C      DERSP   = 'FACDER' FROM CALL TO 'REDSPO'
C      RADSP   = 'FACRAD' FROM CALL TO 'REDSPO'
C
      COMMON /REDMTS/ REDMT(KJRPMX,KLRPA,3),REDSG(KJRPMX,KLRPA),
     &                DERCR(KJRPMX,KLRPA,2),RADCR(KJRPMX,KLRPA,2),
     &                DERSP(KJRPMX,KLRPA,2),RADSP(KJRPMX,KLRPA,2)
C
C END INCLUDE BLOCK

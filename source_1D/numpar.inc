C INCLUDE BLOCK: NUMPAR
C
C CONTIANS PARAMETERS FOR OPTIONS AND NUMERICAL PROCEDURES.
C
C PARAMETERS FOR THE HARTREE-FOCK PART:
C
C      DABR   = DESIRED RELATIVE ERROR IN RADIUS
C      DABE   = DESIRED RELATIVE ERROR IN ENERGY
C      ADDNEW = WEIGHT OF THE NEW WAVE FUNCTION IN MIXING OF
C               WAVE FUNCTIONS TO THE NEW ONE, VALUE BETWEEN 0 AND 1.
C      EPSPR  = END CONDITION FOR PAIRING
C      X0DAMP = SIZE OF GRADIENT STEP KINETIC ENERGY DAMPING.
C               AND SWITCH FOR THE STEP.
C               SWITCH: 'X0DAMP'=0 --> DAMPING BY DIRECT H-INVERSION
C                       'X0DAMP'>0 --> KINETIC ENERGY DAMPING
C      E0DAMP = ENERGY PARAMETER FOR KINETIC ENERGY DAMPING
C      WALL   = HEIGHT OF THE ARTIFICIAL WALL
C      IFEX   = 1 --> COULOMB EXCHANGE ENERGY IN LOCAL DENSITY APPROXIMATION
C                     IS INCLUDED
C      IFTM   = 1 --> 'T1-T2'-TERM IN SPIN-ORBIT FORCE IS INCLUDED
C      ITMAX  = MAXIMUM NUMBER OF HARTREE-FOCK ITERATIONS
C      ITPR   = 'ABS(ITPR)' IS MAXIMUM NUMBER OF PAIRING ITERATIONS,
C               'ITPR'<0 --> CONSTANT GAP APPROACH
C               'ITPR'>0 --> CONSTANT FORCE APPROACH
C      IWR    = PRINT LEVEL (-2,-1,0,+1)
C      IFDFMS = 1 --> DIFFERENT MASS FOR NEUTRON AND PROTON
C               0 --> SAME MASS FOR PROTON AND NEUTRON,
C                     HBAR**2/2M = 20.7525 MEV*FM**2
C      IFENRG = 1 --> TOTAL ENERGY IS COMPUTED FROM SCRATCH AT THE
C                     END OF THE ITERATION
C               0 --> ITERATED FIELDS ARE USED FOR ENERGY COMPUTATION
C      IFRSO  = 1 --> SPIN-ORBIT CONTRIBUTION TO CHARGE DENSITY IS INCLUDED
C      IFGSC  = SWITCHES HANDLING OF THEORIES 'ON TOP' OF HARTREE-FOCK:
C               0 --> NO FURTHER CALCULATION;
C               1 --> CALLS RPA&GSC PROGRAM 'SUMRUL';
C               2 --> CALLS CONTINUUM RPA PROGRAM 'EXTRSP';
C               3 --> CALLS POLARIZATION CORRECTION PROGRAM 'SPECOR':
C               4 --> CALLS PRINTOUT OF SEPARABLE MATRIX ELEMENTS 'RESMTE'
C      IFZPE  = 1 --> ZERO-POINT ENERGY CORRECTION IS COMPUTED AS
C                     <P**2>/(2AM)
C               0 --> ZERO-POINT ENERGY IS APPROXIMATED BY THE EFFECTIVE
C                     MASS TRICK  M ==> M*(1-1/A)
C      IFRHOC = SWITCH FOR CHARGE- OR PROTON-DENSITY IN COULOMB ENERGY:
C                0 --> PROTON-DENSITY IS USED FOR COULOMB POTENTIAL
C                1 --> CHARGE-DENSITY IS USED FOR COULOMB POTENTIAL
C      IDISC  = SWITCH FOR SAVING AND READING WAVE FUNCTION FROM DISC
C                1 --> USE FILE 19 FOR INTERMEDIATE STORAGE
C               -1 --> WAVE FUNCTION IS NOT SAVED AND NOT READ
C      IFREAD = INDICATES WHETHER THE WAVE FUNCTION FOR THE NUCLEUS TO
C               BE COMPUTED HAS BEEN READ SUCCESFULLY IN 'BUFFIO'
C      IFPLOT = 1 --> COMPRESSED INFORMATION ON FILE 11,
C                     E.G. FOR PLOTTING
C      IFENAV = 1 --> THE ENERGY AVERAGE OF MULTIPOLE EXCITATIONS
C                     IS COMPUTED IN 'WIDTH'
C      IFSAVE = SWITCH FOR SAVING THE WAVEFUNCTIONS ON FILE 19,
C               IS SET IN CHI**2 FITTING ROUTINE 'XD1'.
C
C PARAMETERS FOR THE LINEAR RESPONSE PART:
C
C      EPSRPA = STEPSIZE FOR ITERATIVE INVERSION IN THE LINEAR
C               RESPONSE PART
C      RPAMIX = OBSOLETE
C      DABRPA = DESIRED PRECISION FOR RPA ITERATIONS
C      IFIRPA = SWITCH FOR "INVERSE RPA"
C                1 --> INVERSE-MOMENTUM RPA IS COMPUTED
C      IFGRHO = GSC ON DESNITY IS COMPUTED
C      IFANLR = LEVEL OF ANALYSIS AND PRINTOUT
C      ITRPA  = MAXIMUM NUMBER OF ITERATIONS IN THE ITERATIVE INVERSIONS
C
C     PARAMETER FOR THE FITTING PART:
C      IERROR = RETURNS AN ERROR FLAG IN CASE OF INCOMPLETE CONVERGENCE
C               IN THE HARTREE-FOCK ITERATION
!     Parameter for the HFB step:
!      thfbfac = switch to step-wise introduction of HFB step
!      iterhfb = number of steps for reducing initially enhanced strength
!      iterbcs = number of initial BCD steps
!      iternat = number of HFB steps in configuration space
!      modnat  = modulus for running interlaced stepin config. space
!      pairenhance = factor for inigtially enhanced pairing strength
!      
C
       CHARACTER*50 TITLE
       LOGICAL :: thfbfac,tnamelist
       COMMON /NUMPAR/ DABR,DABE,ADDNEW,EPSPR,X0DAMP,E0DAMP,WALL,
     &                 EPSRPA,RPAMIX,DABRPA,
     &                 v2limh,delmix,pairenhance,
     &                 IFEX,IFTM,ITMAX,ITPR,IWR,IFDFMS,
     &                 IFENRG,IFRSO,IFGSC,IFZPE,IFRHOC,IDISC,IFREAD,
     &                 IFPLOT,IFENAV,IFSAVE,
     &                 IFIRPA,IFGRHO,IFANLR,ITRPA,
     &                 iterhfb,iternat,modnat,iterbcs,
     &                 IERROR,thfbfac,tnamelist,    TITLE
C END INCLUDE BLOCK

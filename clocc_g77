#!/bin/bash

# No space after the equals sign, and use quotes to treat all options as a single string.
OPTIONS="-O3 -msse4.2 -mtune=native -mavx -mfpmath=sse -ffast-math -finline-functions -fno-align-commons -fdefault-real-8 -fdefault-double-8"

# Optional: You can uncomment this line to use a different set of options
# OPTIONS="-g -fbacktrace -fbounds-check"

cd testocc
gfortran $OPTIONS -c weak-charge.f90
gfortran $OPTIONS -c xx.f90
gfortran $OPTIONS -c NMP-entry.f90
gfortran $OPTIONS -c Gauss_folding.f90
gfortran $OPTIONS -c hfb-matrix.f
gfortran -g -c givens.f
gfortran -w -ffpe-summary=none $OPTIONS -o ../hafotest.exe haforpa.f givens.o weak-charge.o  NMP-entry.o hfb-matrix.o xx.o Gauss_folding.o
cd ..